{
  "name": "bnomei/kirby3-recently-modified",
  "description": "Kirby Panel fields for recently modified pages and their editors",
  "license": "MIT",
  "type": "kirby-plugin",
  "version": "6.0.0",
  "authors": [
    {
      "name": "Bruno Meilick",
      "email": "b@bnomei.com"
    }
  ],
  "keywords": [
    "kirby",
    "kirby-cms",
    "kirby-plugin",
    "modified",
    "user",
    "page",
    "pages",
    "collection",
    "list",
    "section",
    "widget",
    "recently",
    "changes"
  ],
  "require": {
    "php": "~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
    "getkirby/composer-installer": "^1.2"
  },
  "extra": {
    "kirby": { "compatible": "^6.0" }
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "conflict": {
    "getkirby/cms": "<6.0.0 || >=7.0.0"
  },
  "scripts": {
    "dist": [
      "composer install --no-dev --optimize-autoloader",
      "git rm -rf --cached .; git add .;"
    ]
  }
}
